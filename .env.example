# ─── App ───────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Backend ───────────────────────────────────────────
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0

# ─── PostgreSQL ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vertexlearn
POSTGRES_USER=vertexlearn_user
POSTGRES_PASSWORD=change_me_in_production

DATABASE_URL=postgresql://vertexlearn_user:change_me_in_production@localhost:5432/vertexlearn

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── MinIO ──────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=vertexlearn-assets
MINIO_USE_SSL=false

# ─── AI Service ─────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# ─── JWT (backend) ──────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_EXPIRES_IN=7d

# ─── OpenAI / LLM provider ──────────────────────────────
OPENAI_API_KEY=your_openai_key_here
